# Environment variables for expirationRunNow function

# Azure DevCenter Configuration
ADE_SUBSCRIPTION_ID=your-subscription-id
ADE_DEV_CENTER=your-devcenter-name
ADE_PROJECT_NAME=your-project-name

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Set to "1" to mock Slack messages (useful for testing)
# SLACK_MOCK=0

# Optional: Days before expiration to warn (default: 3)
# EXPIRATION_WARN_DAYS=3

# Azure Functions Runtime
FUNCTIONS_WORKER_RUNTIME=python
